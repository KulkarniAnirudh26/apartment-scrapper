# Only needed if you run with --use-llm (the opt-in Claude fallback).
# A normal run never reads this and costs zero tokens.
ANTHROPIC_API_KEY=

# Only needed for --area discovery (Google Places). If left blank, the scraper
# falls back to the key in ../maps-lead-finder/backend/.env automatically.
GOOGLE_PLACES_API_KEY=

# Optional: a Brave Search API key enables a more reliable website resolver
# instead of the default best-effort Bing scrape (see resolve.py).
BRAVE_API_KEY=

# Only needed for --email (mailing the run report). Generate an App Password at
# myaccount.google.com/apppasswords - it needs 2-step verification on the
# account, and your normal Gmail password will NOT work for SMTP. Spaces in the
# password are fine, they get stripped.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where the report goes. Optional; defaults to GMAIL_USER.
EMAIL_TO=
